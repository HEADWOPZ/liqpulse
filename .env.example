# Feed: mock | live | auto (live sources, fall back to mock if none reachable)
LIQPULSE_FEED=auto

# Comma-separated sources. Available: mock, okx, hyperliquid, velocity, binance, bybit
LIQPULSE_SOURCES=okx,hyperliquid,velocity,binance,bybit

# Canonical majors. SOL is the Solana-perps proxy asset.
LIQPULSE_SYMBOLS=BTC,ETH,SOL

# SQLite by default. Postgres: postgresql+psycopg://user:pass@host:5432/liqpulse
DATABASE_URL=sqlite:///./data/liqpulse.db

# Paper ledger starting cash (USD). No live order routing in v1.
LIQPULSE_PAPER_CASH=100000

# Optional. Direct CEX REST does not need keys. Documented if you later raise limits.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Coinglass is not used unless a key is present (free public dump requires a key).
COINGLASS_API_KEY=

# Delivery. Empty = dry-run only (print payload, do not POST).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Web desk
LIQPULSE_HOST=127.0.0.1
LIQPULSE_PORT=8080
